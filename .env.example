# PostgreSQL connection string (local Docker, Supabase, Neon, etc.)
DATABASE_URL=postgresql://formchat:formchat@localhost:5432/formchat
# Secret used to sign session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Public base URL of the app (used for share links and embed snippets)
NEXT_PUBLIC_APP_URL=http://localhost:3000
